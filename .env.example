# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Backend: "gemini" (default, faster) or "ollama" (local, no internet needed)
MODEL_BACKEND=gemini

# Gemini API key — get one at https://aistudio.google.com/
# Gemma 4 on the Gemini API: gemma-4-26b-a4b-it (tested) or gemma-4-31b-it (slower). List yours with client.models.list().
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it

# Ollama local model (must be pulled first: ollama pull gemma4:e4b)
OLLAMA_MODEL=gemma4:e4b
