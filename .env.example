# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Backend: "gemini" (default, faster) or "ollama" (local, no internet needed)
MODEL_BACKEND=gemini

# Gemini API key — get one at https://aistudio.google.com/
# Verify the exact model ID in AI Studio (e.g. gemini-2.0-flash or gemini-2.5-flash-preview-05-20)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama local model (must be pulled first: ollama pull gemma4:e4b)
OLLAMA_MODEL=gemma4:e4b
